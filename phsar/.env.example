# --- REQUIRED -----------------------------------------------------------------
# The app will not start without these. Everything further down is optional and
# ships at its documented default; a line that is commented out IS its default.
# SECRET_KEY and SEARCH_SECRET_KEY sign access tokens and search URLs — generate
# them randomly at 256 bits or more (roughly 43 characters), and change every
# placeholder credential below before this leaves your machine.
DB_USER=animeuser
DB_PASSWORD=animepass
DB_HOST=localhost
DB_PORT=5432
DB_NAME=anime_db
ADMIN_USERNAME=admin
ADMIN_PASSWORD=supersecretpassword
SECRET_KEY=supersecretsecretkey
SEARCH_SECRET_KEY=supersecretsearchsecretkey

# --- MyAnimeList official API v2 (data source) ------------------------------
# REQUIRED. Client ID from your MAL API panel (https://myanimelist.net/apiconfig).
# Public data needs no OAuth — the scraper sends this as the X-MAL-CLIENT-ID
# header on every request. Fails closed if unset.
MY_ANIME_LIST_CLIENT_ID=your_mal_client_id_here
# Optional overrides (defaults shown). Base URL + 1 req/s rate interval; only
# change if MAL's policy changes or you front the API with a proxy.
# MAL_BASE_URL=https://api.myanimelist.net/v2
# MAL_MIN_REQUEST_INTERVAL_S=1.0

# Optional: seeded guest account (restricted_user role, read-only)
# GUEST_USERNAME=guest
# GUEST_PASSWORD=guestpassword

# --- Auth + search tokens ---------------------------------------------------
# JWT signing algorithm. Changing it invalidates every issued token, so it is
# effectively fixed for a running deployment.
# ALGORITHM=HS256
# Stamped into each search token. Bump it to expire every outstanding token at
# once when a change to the search API would make old ones decode wrongly.
# CURRENT_SEARCH_API_VERSION=v1.1.0
# Search tokens travel in the URL, so both bounds keep them addressable: how many
# entries any ONE list filter may carry (per-field, not a token total), and the
# character ceiling that is safe for a URL.
# MAX_ITEMS=5
# MAX_TOKEN_LENGTH=1400

# --- docker-compose only (native uvicorn dev uses defaults) -----------------
# CORS origins for the backend. In compose-parity mode the frontend is served
# on :3000; native dev uses :5173 (covered by the backend default).
# CORS_ORIGINS=["http://localhost:3000"]
# Frontend reads at runtime via $env/dynamic/public. Native dev defaults to
# http://localhost:8000.
# PUBLIC_API_BASE_URL=http://localhost:8000
# Surfaced on /health and in the footer; gets baked into both images as a
# build arg when docker-compose builds.
# APP_VERSION=dev

# --- Backups ----------------------------------------------------------------
# Where dumps land. Defaults to ./backups (cwd-relative) so native uvicorn dev
# works without root; the container Dockerfile sets BACKUP_DIR=/backups.
# BACKUP_DIR=./backups
# pg_restore timeout. Raise if the DB grows large enough that restores
# legitimately take > 10 min. A mid-restore kill leaves the DB half-dropped.
# BACKUP_RESTORE_TIMEOUT_SECONDS=600

# JWT lifetime, and therefore the sliding-session idle clock: the frontend
# refreshes on activity, warns over the last 3 minutes, and logs out at
# expiry. Keep it comfortably above the warning window — dropping it near
# or below 3 min means the banner never gets a chance to show.
# ACCESS_TOKEN_EXPIRE_MINUTES=10
# Echoes every SQL statement. Very noisy; local debugging only.
# DEBUG=False

# --- Content pipeline (jobs + sweeps) ---------------------------------------
# Shared bearer secret for every cron-authed endpoint:
#   POST /admin/backups/auto              (scheduled dump, ad-hoc)
#   POST /admin/jobs/schedule-sweep       (nightly catalog refresh, ad-hoc)
#   POST /admin/jobs/schedule-seasonal    (weekly current-season pickup, ad-hoc)
#   POST /admin/jobs/schedule-upcoming    (next-season pre-scrape, ad-hoc)
#   POST /admin/jobs/schedule-nightly     (combined daily entry — recommended)
# Leave empty to disable every cron endpoint (they fail closed).
JOBS_CRON_TOKEN=
# Max queued+running user_scrape jobs per non-system user. Bounds queue
# DEPTH per user, NOT worker concurrency — the worker is still strictly
# sequential because MAL's 1 req/s rate limit means parallel jobs would
# just fragment bandwidth.
# JOBS_PER_USER_LIMIT=4
# Max user_scrape submissions per non-admin user in any trailing 24h
# window, counting every status so a fast-failing client can't cycle
# through it. Admins are exempt. The 51st returns 429.
# JOBS_DAILY_LIMIT=50
# Re-running the same /jobs/scrape query within this window returns 409.
# Failed jobs don't count, so a transient MAL outage doesn't lock a user out.
# JOBS_DEDUPE_HOURS=24
# Bounds the nightly update_sweep batch — a MEDIA count
# (~500 media ≈ a 6-7 min maintenance window at MAL's rate).
# JOBS_SWEEP_MAX_PER_RUN=500
# Circuit breaker for the nightly sweep: this many CONSECUTIVE step-1
# failures categorised upstream_outage abort the run. Without it a total
# MAL outage makes every due media pay the full retry budget while
# maintenance is held, which means 503 on login for hours. A non-upstream
# failure (a stray 404) neither trips nor resets the count.
# JOBS_SWEEP_ABORT_AFTER_CONSECUTIVE_FAILURES=10
# Re-runs the relation classifier over the catalog at lifespan startup.
# First cold start on an upgrade-from-pre-v0.14.1 catalog lazy-fetches
# missing MediaRelationEdges sidecars from MAL at ~1 req/s (~14 min for
# an 800-media catalog); subsequent restarts skip already-populated rows
# and finish in seconds. Disable on first deploy if Coolify's liveness
# probe would time out, then run a manual backfill after startup.
# RELATION_BACKFILL_ON_STARTUP=True
# Regenerates EVERY search embedding in place at startup, so the catalog
# picks up a change to generate_embedding. Runs post-yield in the
# background (a ~5-9 min re-encode must not block /health). Wasteful on
# every restart: turn on for a single deploy, watch for the
# "Re-embed complete" log line, then turn it off again.
# EMBEDDING_REEMBED_ON_STARTUP=False
